import asyncio
from pyrogram import Client, filters
from pyrogram.errors import FloodWait, PhoneNumberBanned, BadRequest
from JoKeRUB import l313l
import config  # استيراد بيانات API من ملف config.py

# حالة الفحص (يبدأ معطلًا)
CHECKER_ENABLED = False

@l313l.on_message(filters.me & filters.command("تفعيل_الفحص", prefixes="."))
async def enable_checker(client, message):
    global CHECKER_ENABLED
    CHECKER_ENABLED = True
    await message.reply("✅ تم **تفعيل** الفحص، يمكنك الآن استخدام `.رقم`.")

@l313l.on_message(filters.me & filters.command("ايقاف_الفحص", prefixes="."))
async def disable_checker(client, message):
    global CHECKER_ENABLED
    CHECKER_ENABLED = False
    await message.reply("🚫 تم **إيقاف** الفحص، لن يعمل الأمر `.رقم` الآن.")

@l313l.on_message(filters.me & filters.command("رقم", prefixes="."))
async def check_number(client, message):
    global CHECKER_ENABLED

    if not CHECKER_ENABLED:
        return await message.reply("⚠️ الفحص معطل! قم بتشغيله باستخدام `.تفعيل_الفحص`.")

    try:
        # استخراج الرقم من الرسالة
        text = message.text.split()
        if len(text) < 2:
            return await message.reply("⚠️ استخدم الأمر بهذا الشكل: \n`.رقم +123456789`")
        
        phone_number = text[1].strip()
        
        if not phone_number.startswith("+"):
            return await message.reply("❌ الرقم غير صالح، يجب أن يبدأ برمز الدولة.")

        processing_message = await message.reply("⏳ انتظر، جاري الفحص...")

        # إنشاء جلسة مؤقتة
        temp_client = Client(name=":memory:", api_id=config.api_id, api_hash=config.api_hash, in_memory=True)

        try:
            await temp_client.connect()
            await temp_client.send_code(phone_number)  # فحص الرقم بإرسال كود
            result = f"✅ الرقم {phone_number} يعمل."
        except PhoneNumberBanned:
            result = f"🚫 الرقم {phone_number} محظور."
        except BadRequest as e:
            result = f"⚠️ الرقم {phone_number}: غير صالح ({str(e)})."
        except FloodWait as e:
            await asyncio.sleep(e.value)  # انتظار الوقت المطلوب لتجنب الحظر
            result = f"⚠️ تأخر الفحص بسبب قيود التليجرام ({e.value} ثانية)."
        except Exception as e:
            result = f"⚠️ الرقم {phone_number}: خطأ غير معروف ({str(e)})."
        finally:
            await temp_client.disconnect()

        await asyncio.sleep(2)  # تجنب الحظر بسبب الفحص السريع
        await processing_message.edit_text(f"🔍 - نتيجة الفحص:\n\n{result}")

    except Exception as e:
        await message.reply(f"❌ حدث خطأ: {str(e)}")
